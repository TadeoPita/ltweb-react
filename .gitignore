node_modules/
/.pnp
.pnp.js

# Production
/dist

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# El paquete para subir a mano. Se regenera con `npm run empaquetar`.
ltweb-sitio.zip

# La contraseña del panel (solo el hash, pero igual no va al repositorio).
datos/acceso.json

# Las imágenes que se suben desde el panel EN EL SERVIDOR viven acá y no
# viajan con el código. Las que se cargan en desarrollo van a public/subidas,
# que sí se versiona.
/subidas

# El archivo con la contraseña del panel que genera scripts/generar-acceso.js.
# Es para leerlo una vez y borrarlo: nunca al repositorio.
MI-CLAVE-DEL-PANEL.txt

# El contenido con el que trabaja el panel EN EL SERVIDOR. Fuera del repo a
# proposito: si estuviera versionado, cada despliegue lo pisaria con la copia
# del repositorio y se perderia todo lo cargado desde el panel.
# Lo que si viaja es datos/semilla.json, que es el punto de partida.
datos/proyectos.json

# Lo que este codigo genera solo en tiempo de ejecucion: la copia publicada
# (fuera del build a proposito, ver rutasProduccion en servidor/lib/datos.js),
# los respaldos rotativos antes de cada guardado, y las imagenes subidas desde
# el panel en la ubicacion nueva (antes vivian en /subidas a secas).
datos/publicado/
datos/respaldo-*.json
datos/subidas/

# Archivos de trabajo del relevamiento SEO. Se regeneran cuando haga falta y
# el contenido real vive en el panel, no acá.
relevamiento.json
fichas-borrador.json
fichas-para-importar.json
FICHAS-SEO.md
